<div class="kg-dice">
{{#unless active}}
  <p class="kg-empty">{{localize "KNUCKLES.dice.none"}}</p>
{{else}}
  {{#if choosing}}<div class="kg-muted" style="margin-bottom:10px">{{localize "KNUCKLES.dice.hint"}}</div>{{/if}}
  {{#if genAll}}
    <div class="kg-gen kg-gen-all">
      <span class="kg-gmtag">{{localize "KNUCKLES.gen.gm"}}</span>
      <b class="kg-gen-title">{{localize "KNUCKLES.gen.title"}}</b>
      <select class="kg-gen-count" data-gen-knob data-gen-id="{{genAll.id}}" data-gen-knob-kind="count" aria-label="{{localize 'KNUCKLES.gen.count'}}">
        {{#each genAll.counts}}<option value="{{n}}"{{#if selected}} selected{{/if}}>{{n}}</option>{{/each}}
      </select>
      <select class="kg-gen-class" data-gen-knob data-gen-id="{{genAll.id}}" data-gen-knob-kind="class" aria-label="{{localize 'KNUCKLES.gen.classLabel'}}">
        {{#each genAll.classes}}<option value="{{id}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}
      </select>
      <span class="kg-gen-acts">
        <span class="kg-gen-seg" role="group" aria-label="{{localize 'KNUCKLES.gen.modeLabel'}}">
          <button type="button" class="{{#if genAll.random}}on{{/if}}" data-action="genMode" data-gen-id="{{genAll.id}}" data-mode="random" aria-pressed="{{#if genAll.random}}true{{else}}false{{/if}}">{{localize "KNUCKLES.gen.random"}}</button>
          <button type="button" class="{{#unless genAll.random}}on{{/unless}}" data-action="genMode" data-gen-id="{{genAll.id}}" data-mode="matched" aria-pressed="{{#unless genAll.random}}true{{else}}false{{/unless}}">{{localize "KNUCKLES.gen.matched"}}</button>
        </span>
        <button type="button" class="kg-gen-deal" data-action="genDealAll"><i class="fa-solid fa-shuffle" aria-hidden="true"></i> {{localize "KNUCKLES.gen.dealAll"}}</button>
      </span>
    </div>
    <div class="kg-gen-note">{{localize "KNUCKLES.gen.dealAllHint"}}</div>
  {{/if}}
  <div class="kg-dchars">
  {{#each players}}
    <div class="kg-dchar">
      <div class="kg-dchar-head">
        <span class="kg-pname">{{name}}{{#if ready}} <i class="fa-solid fa-check" aria-hidden="true" style="color:var(--kg-win)"></i>{{/if}}</span>
        {{#if tally}}<span class="kg-tally{{#unless tally.ok}} is-short{{/unless}}"><i class="fa-solid {{#if tally.ok}}fa-check{{else}}fa-triangle-exclamation{{/if}}" aria-hidden="true"></i> {{tally.have}} / 6</span>{{/if}}
        {{#if canSaveDefault}}<span class="kg-defbtns">
          <button type="button" class="kg-defbtn" data-action="saveDefault" data-player-id="{{id}}" title="{{localize 'KNUCKLES.dice.saveDefaultHint'}}"><i class="fa-solid fa-bookmark" aria-hidden="true"></i> {{localize "KNUCKLES.dice.saveDefault"}}</button>
          {{#if hasDefault}}<button type="button" class="kg-defbtn ghost" data-action="resetDefault" data-player-id="{{id}}" title="{{localize 'KNUCKLES.dice.resetDefaultHint'}}"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i> {{localize "KNUCKLES.dice.resetDefault"}}</button>{{/if}}
        </span>{{/if}}
      </div>
      {{#if tally}}<div class="kg-buyhint">{{#if buyHint}}<i class="fa-solid fa-gift" aria-hidden="true"></i> {{buyHint}}{{/if}}</div>{{/if}}
      {{#if stockNote}}<div class="kg-stocknote"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> {{stockNote}}</div>{{/if}}
      {{#if gen}}
        <div class="kg-gen">
          <span class="kg-gmtag">{{localize "KNUCKLES.gen.gm"}}</span>
          <select class="kg-gen-count" data-gen-knob data-gen-id="{{gen.id}}" data-gen-knob-kind="count" aria-label="{{localize 'KNUCKLES.gen.count'}}">
            {{#each gen.counts}}<option value="{{n}}"{{#if selected}} selected{{/if}}>{{n}}</option>{{/each}}
          </select>
          <select class="kg-gen-class" data-gen-knob data-gen-id="{{gen.id}}" data-gen-knob-kind="class" aria-label="{{localize 'KNUCKLES.gen.classLabel'}}">
            {{#each gen.classes}}<option value="{{id}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          <span class="kg-gen-acts">
            <span class="kg-gen-seg" role="group" aria-label="{{localize 'KNUCKLES.gen.modeLabel'}}">
              <button type="button" class="{{#if gen.random}}on{{/if}}" data-action="genMode" data-gen-id="{{gen.id}}" data-mode="random" aria-pressed="{{#if gen.random}}true{{else}}false{{/if}}">{{localize "KNUCKLES.gen.random"}}</button>
              <button type="button" class="{{#unless gen.random}}on{{/unless}}" data-action="genMode" data-gen-id="{{gen.id}}" data-mode="matched" aria-pressed="{{#unless gen.random}}true{{else}}false{{/unless}}">{{localize "KNUCKLES.gen.matched"}}</button>
            </span>
            <button type="button" class="kg-gen-deal" data-action="genDeal" data-gen-id="{{gen.id}}" title="{{localize 'KNUCKLES.gen.dealHint'}}"><i class="fa-solid fa-dice" aria-hidden="true"></i> {{localize "KNUCKLES.gen.deal"}}</button>
          </span>
        </div>
      {{/if}}
      <div class="kg-dslots">
        {{#each slots}}
          <label class="kg-dslot">
            <span class="kg-idx">#{{n}}</span>
            <select data-die-slot data-player-id="{{../id}}" data-slot="{{slot}}" aria-label="{{localize 'KNUCKLES.dice.slotLabel'}} {{n}}">
              {{#each options}}<option value="{{id}}"{{#if selected}} selected{{/if}}{{#if disabled}} disabled{{/if}} title="{{flavor}}">{{label}}</option>{{/each}}
            </select>
            {{#if mark}}<span class="kg-owned {{mark.cls}}" role="img" aria-label="{{mark.title}}" title="{{mark.title}}"><i class="fa-solid {{mark.icon}}" aria-hidden="true"></i></span>{{/if}}
          </label>
        {{/each}}
      </div>
    </div>
  {{/each}}
  </div>
  <footer class="kg-dice-foot">
    {{#if choosing}}
      {{#if isGM}}
        <button type="button" class="primary" data-action="startPlay"><i class="fa-solid fa-play" aria-hidden="true"></i> {{localize "KNUCKLES.dice.start"}}</button>
        <button type="button" class="kg-end" data-action="endGame"><i class="fa-solid fa-flag-checkered" aria-hidden="true"></i> {{localize "KNUCKLES.board.endGame"}}</button>
      {{else}}
        {{#if allReady}}<button type="button" data-action="ready"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i> {{localize "KNUCKLES.dice.notReady"}}</button>
        {{else}}<button type="button" class="primary" data-action="ready"><i class="fa-solid fa-check" aria-hidden="true"></i> {{localize "KNUCKLES.dice.ready"}}</button>{{/if}}
      {{/if}}
    {{else}}
      <button type="button" data-action="close">{{localize "KNUCKLES.dice.close"}}</button>
    {{/if}}
  </footer>
{{/unless}}
</div>
