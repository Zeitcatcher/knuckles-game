<div class="kg-stakes">
  <p class="kg-stakes-lead">{{localize "KNUCKLES.stakes.short"}}</p>
  {{#if payerNames}}<p class="kg-stakes-paid"><i class="fa-solid fa-check" aria-hidden="true"></i> {{localize "KNUCKLES.stakes.paidFull" names=payerNames}}</p>{{/if}}

  {{#each rows}}
    <div class="kg-srow" data-row-id="{{id}}">
      <div class="kg-srow-head">
        <span class="kg-srow-name">{{name}}</span>
        <span class="kg-srow-short">{{localize "KNUCKLES.stakes.shortBy"}} {{kgCoins shortCoins}}</span>
        <span class="kg-seg">
          <button type="button" data-action="setMode" data-row-id="{{id}}" data-mode="borrow" class="{{#if isBorrow}}on{{/if}}">{{localize "KNUCKLES.stakes.borrow"}}</button>
          <button type="button" data-action="setMode" data-row-id="{{id}}" data-mode="mint" class="{{#if isMint}}on{{/if}}">{{localize "KNUCKLES.stakes.mint"}}</button>
        </span>
      </div>
      {{#if isBorrow}}
        <div class="kg-lenders">
          {{#each lenders}}
            <div class="kg-lrow{{#unless canLend}} is-off{{/unless}}">
              <input type="checkbox" data-action="toggleLender" data-row-id="{{../id}}" data-lender="{{uuid}}" {{#if checked}}checked{{/if}} {{#unless canLend}}disabled{{/unless}} aria-label="{{name}}" />
              <span class="kg-lname">{{name}}</span>
              {{#if canLend}}
                {{#if ../editing}}
                  <span class="kg-coinedit">{{#each coinFields}}<input class="kg-cin" type="number" min="0" step="1" value="{{value}}" data-row-id="{{../../id}}" data-lender="{{../uuid}}" data-coin="{{key}}" /><span class="kg-coin kg-coin-{{key}}" aria-hidden="true"></span>{{/each}}</span>
                {{else}}
                  {{#if checked}}<span class="kg-lgive">{{localize "KNUCKLES.stakes.gives"}} {{kgCoins giveCoins}}</span>{{/if}}
                {{/if}}
              {{else}}
                <span class="kg-lgive">{{localize "KNUCKLES.stakes.noCoins"}}</span>
              {{/if}}
            </div>
          {{/each}}
          <div class="kg-lrow">
            <button type="button" class="kg-editlink" data-action="editAmounts" data-row-id="{{id}}"><i class="fa-solid fa-pen" aria-hidden="true"></i> {{localize "KNUCKLES.stakes.editAmounts"}}</button>
            <span style="margin-left:auto"></span>
            {{#if allocated}}<span class="kg-alloc-ok"><i class="fa-solid fa-check" aria-hidden="true"></i> {{localize "KNUCKLES.stakes.allAllocated"}}</span>
            {{else}}<span class="kg-alloc-short">{{localize "KNUCKLES.stakes.remaining"}} {{kgCoins remainingCoins}}</span>{{/if}}
          </div>
        </div>
      {{/if}}
    </div>
  {{/each}}

  <div class="kg-stakes-foot">
    <button type="button" data-action="mintAll"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> {{localize "KNUCKLES.stakes.mintAll"}}</button>
    <span class="kg-spacer"></span>
    <button type="button" data-action="cancel">{{localize "KNUCKLES.stakes.cancel"}}</button>
    <button type="button" class="primary" data-action="confirm"{{#unless canConfirm}} disabled{{/unless}}><i class="fa-solid fa-play" aria-hidden="true"></i> {{localize "KNUCKLES.stakes.confirm"}}</button>
  </div>
  <p class="kg-stakes-note">{{localize "KNUCKLES.stakes.footnote"}}</p>
</div>
